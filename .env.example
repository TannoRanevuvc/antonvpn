# Database
DATABASE_URL=postgresql+asyncpg://antonvpn_user:CHANGE_ME@postgres:5432/antonvpn
REDIS_URL=redis://redis:6379/0

# Telegram bot
TOKEN_BOT_TG=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_LINK=https://t.me/your_bot_username

# Remnawave VPN panel
REMNAWAVE_PANEL_URL=https://panel.your-domain.com
REMNAWAVE_TOKEN=your_remnawave_bearer_token

# Robokassa
SHOP_IND=your_merchant_login
PASS1=your_pass1
PASS2=your_pass2
ROBOKASSA_IS_TEST=true

# Admin panel
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
BASE_ADMIN_URL=/admin
ADMIN_PUBLIC_BASE_URL=https://your-domain.com
JWT_SECRET_KEY=CHANGE_ME_RANDOM_SECRET

# Channel gate (optional — can also be set via admin panel)
CHANNEL_ID=0

# Optional: SOCKS5 proxy for bot in restricted environments
# SOCKS5_PROXY_URL=socks5://user:pass@host:port
